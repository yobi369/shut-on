<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#171714">
  <meta name="description" content="Shuton Photography captures weddings, celebrations, portraits, brands and events across Voi and Taita Taveta, Kenya.">
  <title><%= pageTitle || 'Shuton Photography | Stories Worth Keeping' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--ink:#171714;--paper:#f7f5f0;--muted:#6e6a62;--accent:#c7a46a;--line:rgba(23,23,20,.14);--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif}
    *{box-sizing:border-box}html{scroll-behavior:smooth;overflow-x:clip}body{margin:0;max-width:100%;overflow-x:clip;background:var(--paper);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}img{display:block;width:auto;max-width:100%;height:auto}.topline{height:4px;background:var(--accent)}\n    /* Responsive media: prevent intrinsic image dimensions from breaking narrow screens. */\n    .hero-image,.service-photo img,.feature-photo img,.portfolio-card img{display:block;width:100%;max-width:100%;height:100%;object-fit:cover}.hero,.services,.feature,.portfolio,.contact-band,footer{min-width:0;max-width:100%}.nav,.nav-links,.section-head,.contact-band,.footer-main{min-width:0}.nav-links a,.button{overflow-wrap:anywhere}
    .nav{position:absolute;z-index:5;top:4px;left:0;width:100%;display:flex;align-items:center;justify-content:space-between;padding:22px clamp(20px,5vw,76px);color:#fff}.brand{display:flex;align-items:center;gap:12px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;font-size:.82rem}.brand img{width:46px;height:46px;object-fit:contain}.brand-mark{width:42px;height:42px;border:1px solid rgba(255,255,255,.7);border-radius:50%;display:grid;place-items:center;font-family:var(--serif);font-size:1.25rem}.nav-links{display:flex;align-items:center;gap:clamp(15px,2.5vw,34px);font-size:.79rem;letter-spacing:.04em}.nav-links a{opacity:.88;transition:opacity .2s,color .2s}.nav-links a:hover{opacity:1;color:#e9cc99}.nav-cta{border:1px solid rgba(255,255,255,.65);padding:11px 16px}
    .hero{position:relative;min-height:min(790px,92svh);display:flex;align-items:flex-end;overflow:hidden;background:#35352e;color:white}.hero-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 45%;animation:hero-in 1.2s ease both}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,10,9,.72) 0%,rgba(10,10,9,.35) 52%,rgba(10,10,9,.08) 100%),linear-gradient(0deg,rgba(10,10,9,.45),transparent 45%)}.hero-content{position:relative;z-index:1;width:min(1240px,100%);margin:0 auto;padding:180px clamp(24px,7vw,100px) 92px}.eyebrow{display:flex;align-items:center;gap:12px;text-transform:uppercase;letter-spacing:.2em;font-size:.7rem;font-weight:700}.eyebrow:before{content:"";width:34px;height:1px;background:var(--accent)}.hero h1{font:500 clamp(3rem,7.5vw,6.6rem)/1.02 var(--serif);letter-spacing:-.045em;max-width:850px;margin:24px 0}.hero h1 em{color:#e4c28b;font-weight:500}.hero-copy{font-size:clamp(1rem,1.4vw,1.15rem);line-height:1.8;color:rgba(255,255,255,.82);max-width:500px;margin:0 0 30px}.actions{display:flex;flex-wrap:wrap;gap:12px}.button{min-height:49px;display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:0 21px;font-size:.82rem;font-weight:700;letter-spacing:.03em;transition:transform .2s,background .2s}.button:hover{transform:translateY(-2px)}.button-gold{background:var(--accent);color:#171714}.button-outline{border:1px solid rgba(255,255,255,.65);color:white}.hero-index{position:absolute;z-index:2;right:clamp(24px,7vw,100px);bottom:37px;font-size:.72rem;letter-spacing:.16em;color:rgba(255,255,255,.8)}
    .intro{max-width:1240px;margin:auto;padding:100px clamp(24px,7vw,100px);display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(40px,8vw,120px);align-items:start}.section-kicker{font-size:.7rem;letter-spacing:.19em;text-transform:uppercase;color:#9b7844;font-weight:700}.intro h2,.section-head h2,.contact-panel h2{font:500 clamp(2.25rem,4.4vw,4.2rem)/1.12 var(--serif);letter-spacing:-.035em;margin:18px 0}.intro-copy{font-size:1rem;line-height:1.9;color:var(--muted);max-width:590px;margin:8px 0 25px}.text-link{display:inline-flex;align-items:center;gap:12px;font-size:.82rem;font-weight:700;border-bottom:1px solid var(--accent);padding:0 0 8px}.text-link span{font-size:1.2rem;color:#9b7844}
    .services{background:#eeece5;padding:88px clamp(24px,7vw,100px) 100px}.section-head{max-width:1240px;margin:0 auto 36px;display:flex;justify-content:space-between;align-items:end;gap:30px}.section-head h2{margin-bottom:0}.section-head p{max-width:360px;color:var(--muted);line-height:1.7;margin:0 0 5px;font-size:.92rem}.service-grid{max-width:1240px;margin:auto;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.service-card{min-width:0}.service-photo{height:clamp(220px,28vw,350px);overflow:hidden;background:#d5d0c5}.service-photo img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1)}.service-card:hover .service-photo img{transform:scale(1.045)}.service-number{color:#9b7844;font-size:.68rem;letter-spacing:.15em;margin:19px 0 8px}.service-card h3{font:500 1.35rem var(--serif);margin:0 0 8px}.service-card p{color:var(--muted);font-size:.84rem;line-height:1.65;margin:0}
    .feature{padding:100px clamp(24px,7vw,100px);max-width:1440px;margin:auto;display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(32px,7vw,100px);align-items:center}.feature-photo{height:clamp(350px,48vw,620px);position:relative;background:#d6d0c4}.feature-photo img{width:100%;height:100%;object-fit:cover}.feature-note{position:absolute;right:-15px;bottom:24px;background:var(--accent);padding:19px 22px;font:500 1.05rem var(--serif);max-width:210px}.feature-copy p{color:var(--muted);line-height:1.9;font-size:.96rem}.feature-copy .button{margin-top:14px}
    .portfolio{background:#191a17;color:white;padding:90px clamp(24px,7vw,100px) 100px}.portfolio .section-head{align-items:end}.portfolio .section-head p{color:rgba(255,255,255,.65)}.portfolio-grid{max-width:1240px;margin:auto;display:grid;grid-template-columns:1.15fr .85fr .85fr;gap:15px}.portfolio-card{position:relative;min-height:280px;height:clamp(280px,35vw,430px);overflow:hidden;background:#36362f}.portfolio-card:first-child{height:clamp(320px,42vw,490px)}.portfolio-card img{width:100%;height:100%;object-fit:cover;transition:transform .7s}.portfolio-card:hover img{transform:scale(1.04)}.portfolio-card:after{content:"";position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.55))}.portfolio-label{position:absolute;z-index:1;bottom:22px;left:20px;font:500 1.25rem var(--serif)}
    .contact-band{padding:80px clamp(24px,7vw,100px);background:var(--accent);display:flex;align-items:center;justify-content:space-between;gap:30px}.contact-band h2{font:500 clamp(2rem,4vw,3.6rem)/1.1 var(--serif);margin:0;max-width:680px}.contact-band p{margin:13px 0 0;color:rgba(23,23,20,.75);line-height:1.7}.button-dark{background:var(--ink);color:white;white-space:nowrap}
    footer{background:#171714;color:white;padding:55px clamp(24px,7vw,100px) 25px}.footer-main{max-width:1240px;margin:auto;display:flex;justify-content:space-between;gap:35px;flex-wrap:wrap;padding-bottom:38px}.footer-brand{font:500 1.8rem var(--serif);margin-bottom:12px}.footer-main p,.footer-main a{color:rgba(255,255,255,.65);font-size:.86rem;line-height:1.8}.footer-links{display:flex;gap:22px;flex-wrap:wrap;align-items:start}.footer-bottom{max-width:1240px;margin:auto;border-top:1px solid rgba(255,255,255,.15);padding-top:18px;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;color:rgba(255,255,255,.5);font-size:.72rem}
    @keyframes hero-in{from{transform:scale(1.035);opacity:.75}to{transform:scale(1);opacity:1}}
    @media(max-width:850px){.nav{padding:16px 20px;gap:12px}.nav-links{gap:10px;justify-content:flex-end;flex-wrap:wrap}.nav-links a:not(.nav-cta){display:inline-block}.hero{min-height:760px;min-height:88svh}.hero-content{padding-bottom:105px}.intro{grid-template-columns:1fr;gap:14px;padding-top:70px;padding-bottom:70px}.services{padding-top:70px;padding-bottom:75px}.service-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 14px}.service-photo{height:clamp(220px,52vw,360px)}.feature{grid-template-columns:1fr;padding-top:70px;padding-bottom:70px}.feature-photo{margin-right:12px}.portfolio-grid{grid-template-columns:1fr 1fr}.portfolio-card:first-child{grid-column:1/-1;height:360px}.portfolio-card{height:290px}.contact-band{align-items:flex-start;flex-direction:column}.section-head{align-items:flex-start;flex-direction:column;gap:14px}}
    @media(max-width:600px){.nav{align-items:flex-start}.brand{flex:0 0 auto}.nav-links{max-width:58%;font-size:.68rem;gap:8px}.nav-links a:not(.nav-cta){display:inline-block}.nav-cta{padding:8px 10px}.hero{min-height:680px;min-height:82svh}.hero-image{object-position:58% center}.hero-content{padding-top:145px;padding-bottom:88px}.hero h1{overflow-wrap:normal}.intro,.services,.feature,.portfolio,.contact-band{padding-left:20px;padding-right:20px}.service-photo{height:auto;aspect-ratio:4/5}.feature-photo{height:auto;aspect-ratio:4/5;margin-right:0}.feature-note{right:10px;bottom:12px}.portfolio-card,.portfolio-card:first-child{height:auto;aspect-ratio:4/3;min-height:0}.portfolio-card img{position:absolute;inset:0}.portfolio-label{left:14px;bottom:16px}.footer-main{gap:24px}}\n    @media(max-width:430px){.brand{font-size:.72rem;letter-spacing:.08em}.brand-mark{width:36px;height:36px}.nav-cta{padding:10px 12px}.hero h1{font-size:3.1rem}.hero-content{padding-left:22px;padding-right:22px}.service-grid{gap:25px 12px}.service-card h3{font-size:1.15rem}.service-card p{font-size:.8rem}.portfolio-grid{grid-template-columns:1fr}.portfolio-card:first-child{grid-column:auto;height:350px}.portfolio-card{height:320px}.hero-index{display:none}.footer-links{gap:14px}}
    @media(max-width:360px){.brand{gap:7px;font-size:.63rem}.brand-mark{width:31px;height:31px}.nav{padding:12px}.nav-links{max-width:55%;font-size:.62rem;gap:6px}.hero h1{font-size:2.55rem}.actions{align-items:stretch;flex-direction:column;max-width:100%}.actions .button{width:100%}.section-head h2{font-size:2rem}}\n    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
  </style>
</head>
<body>
  <div class="topline"></div>
  <nav class="nav" aria-label="Main navigation">
    <a class="brand" href="/" aria-label="Shuton Photography home"><span class="brand-mark">S</span><span>Shuton<br>Photography</span></a>
    <div class="nav-links">
      <a href="/gallery">Gallery</a><a href="/work">Our Work</a><a href="/blog">Journal</a><a href="/contact" class="nav-cta">Book a Session ↗</a>
    </div>
  </nav>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <img class="hero-image" src="/images/slider2.jpg" alt="A joyful moment captured by Shuton Photography" fetchpriority="high">
      <div class="hero-content">
        <div class="eyebrow">Photography &amp; visual storytelling · Voi, Kenya</div>
        <h1 id="hero-title">The moments pass.<br><em>Your story stays.</em></h1>
        <p class="hero-copy">Honest, beautiful photography and video for the people, celebrations and brands that matter to you.</p>
        <div class="actions"><a class="button button-gold" href="/contact">Let's create something ↗</a><a class="button button-outline" href="/gallery">Explore the gallery</a></div>
      </div>
      <div class="hero-index">01 — YOUR STORY, BEAUTIFULLY TOLD</div>
    </section>
    <section class="intro">
      <div><div class="section-kicker">A thoughtful eye. A lasting story.</div><h2>Real moments.<br>Remarkable memories.</h2></div>
      <div><p class="intro-copy">At Shuton Photography, we believe the best images do more than show what happened — they bring you back to how it felt. From once-in-a-lifetime celebrations to purposeful brand stories, we create visual work with care, creativity and attention to detail.</p><a class="text-link" href="/work">Discover our approach <span>↗</span></a></div>
    </section>
    <section class="services" id="services">
      <div class="section-head"><div><div class="section-kicker">What we do</div><h2>Made for your moment.</h2></div><p>Thoughtful visual services, shaped around your story and the way you want it remembered.</p></div>
      <div class="service-grid">
        <article class="service-card"><div class="service-photo"><img src="/images/wed.jpg" alt="Wedding photography" loading="lazy"></div><div class="service-number">01 / CELEBRATE</div><h3>Weddings &amp; Events</h3><p>The emotions, the details and all the in-between moments.</p></article>
        <article class="service-card"><div class="service-photo"><img src="/images/corporate1.jpg" alt="Corporate event photography" loading="lazy"></div><div class="service-number">02 / CONNECT</div><h3>Corporate &amp; Brands</h3><p>Professional imagery that gives your brand a human story.</p></article>
        <article class="service-card"><div class="service-photo"><img src="/images/graduation1.jpg" alt="Graduation portrait photography" loading="lazy"></div><div class="service-number">03 / ACHIEVE</div><h3>Portraits &amp; Graduations</h3><p>Celebrate the milestones and the people behind them.</p></article>
        <article class="service-card"><div class="service-photo"><img src="/images/gallery1.jpg" alt="Video coverage and visual production" loading="lazy"></div><div class="service-number">04 / TELL</div><h3>Video &amp; Digital Content</h3><p>Moving images and content built to bring your ideas to life.</p></article>
      </div>
    </section>
    <section class="feature">
      <div class="feature-photo"><img src="/images/gallery2.jpg" alt="Behind the lens with Shuton Photography" loading="lazy"><div class="feature-note">Every frame has a feeling.</div></div>
      <div class="feature-copy"><div class="section-kicker">The Shuton difference</div><h2 style="font:500 clamp(2.3rem,4.7vw,4.3rem)/1.1 var(--serif);letter-spacing:-.035em;margin:18px 0">Not just pictures.<br>A piece of your story.</h2><p>We bring a calm, considered approach to every shoot — helping you feel comfortable in front of the camera while we look for the moments that make your story yours.</p><p>Based in Voi, Taita Taveta, we work with individuals, families, event teams and businesses to create photographs and video worth returning to.</p><a class="button button-gold" href="/contact">Tell us what you have in mind ↗</a></div>
    </section>
    <section class="portfolio">
      <div class="section-head"><div><div class="section-kicker">Selected stories</div><h2>Seen through our lens.</h2></div><p>A glimpse of the people, places and milestones we love to capture.</p></div>
      <div class="portfolio-grid">
        <a class="portfolio-card" href="/gallery"><img src="/images/wed.jpg" alt="Wedding moments" loading="lazy"><span class="portfolio-label">Love &amp; celebration ↗</span></a>
        <a class="portfolio-card" href="/gallery"><img src="/images/corporate1.jpg" alt="Corporate and brand events" loading="lazy"><span class="portfolio-label">People &amp; purpose ↗</span></a>
        <a class="portfolio-card" href="/gallery"><img src="/images/graduation1.jpg" alt="Graduation and milestone portraits" loading="lazy"><span class="portfolio-label">Milestones ↗</span></a>
      </div>
      <div style="max-width:1240px;margin:30px auto 0"><a class="text-link" style="color:#fff" href="/gallery">View the full gallery <span>↗</span></a></div>
    </section>
    <section class="contact-band"><div><h2>Have a moment worth keeping?</h2><p>Tell us what you're planning. We'd love to help you capture it.</p></div><a class="button button-dark" href="/contact">Start a conversation ↗</a></section>
  </main>
  <footer>
    <div class="footer-main"><div><div class="footer-brand">Shuton Photography</div><p>Stories worth keeping, captured with care.<br>Voi, Taita Taveta · Kenya</p></div><div class="footer-links"><a href="/">Home</a><a href="/gallery">Gallery</a><a href="/work">Our Work</a><a href="/blog">Journal</a><a href="/contact">Contact</a><a href="/admin">Studio Login</a></div><div><p>Let's talk about your next shoot.</p><a href="mailto:shutonphotography@gmail.com">shutonphotography@gmail.com</a><br><a href="tel:+254758926530">+254 758 926 530</a></div></div>
    <div class="footer-bottom"><span>© <%= new Date().getFullYear() %> Shuton Photography. All rights reserved.</span><span>Made to keep your stories close.</span></div>
  </footer>
</body>
</html>
