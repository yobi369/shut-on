<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Shuton Photography</title>
    <link rel="stylesheet" href="/main.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Inline styles moved to public/main.css -->
</head>
<body>
    <header>
        <div class="slider">
            <div class="slides">
                <img src="images/image1.jpg" alt="Image 1" class="slide" />
                <img src="images/image2.jpg" alt="Image 2" class="slide" />
                <img src="images/image3.jpg" alt="Image 3" class="slide" />
            </div>
            <div class="carousel-overlay">
                <h1 style="color: white;">Welcome to Shuton Photography</h1>
                <p style="color: white;">We capture life's precious moments</p>
                <button class="btn btn-light btn-lg mt-3" onclick="location.href='/contact'">Contact Us</button>
            </div>
        </div>
    </header>
    <nav class="nav-section">
        <div class="brand-logo">
            <a href="/"><img src="/images/logo.png" alt="Shuton Photography Logo" /></a>
        </div>
        <ul>
            <li><a href="/" class="<%= (typeof activePage !== 'undefined' && activePage === 'home') ? 'active' : '' %>">Home</a></li>
            <li><a href="/gallery" class="<%= (typeof activePage !== 'undefined' && activePage === 'gallery') ? 'active' : '' %>">Gallery</a></li>
            <li><a href="/blog" class="<%= (typeof activePage !== 'undefined' && activePage === 'blog') ? 'active' : '' %>">Blog</a></li>
            <li><a href="/clients" class="<%= (typeof activePage !== 'undefined' && activePage === 'clients') ? 'active' : '' %>">Clients</a></li>
            <li><a href="/work" class="<%= (typeof activePage !== 'undefined' && activePage === 'work') ? 'active' : '' %>">Work</a></li>
            <li><a href="/contact" class="<%= (typeof activePage !== 'undefined' && activePage === 'contact') ? 'active' : '' %>">Contact</a></li>
        </ul>
    </nav>


    <!-- Section One -->
    <section class="section-one">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 sec-one-left">
                    <img src="images/about.jpg" alt="About Us Image">
                </div>
                <div class="col-md-6 work-content">
                    <h3>Welcome to Shuton Photography</h3>
                    <p>At Shuton Photography, we offer world-class services for all your photography needs, from corporate events to nature shoots. We work with top-of-the-line equipment and ensure that every moment is captured beautifully.</p>
                    <div class="work-imgs">
                        <div class="work-img-1">
                            <img src="images/work1.png" alt="Work 1 Image">
                        </div>
                        <div class="work-img-2">
                            <img src="images/work2.jpg" alt="Work 2 Image">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="services">
        <h1>Our Services</h1>
        <div class="service-grid">
            <div class="service-item">
                <img src="images/service1.jpg" alt="Wedding Photography">
                <h4>Wedding Photography</h4>
            </div>
            <div class="service-item">
                <img src="images/service2.jpg" alt="Corporate Photography">
                <h4>Corporate Photography</h4>
            </div>
            <div class="service-item">
                <img src="images/service3.jpg" alt="Studio Photography">
                <h4>Studio Photography</h4>
            </div>
            <div class="service-item">
                <img src="images/service4.jpg" alt="Nature & Travel Photography">
                <h4>Nature & Travel Photography</h4>
            </div>
        </div>
    </section>

   <!-- Portfolio Section -->
<section class="portfolio" id="portfolio">
    <h1>Portfolio</h1>
    <div class="gallery">
        <img src="images/wed.jpg" alt="Wedding Photography">
        <img src="images/corporate2.jpg" alt="Corporate Event Photography">
        <img src="images/graduation1.jpg" alt="Graduation Photography">
    </div>
</section>


    <!-- Contact Section -->
    <!-- Renamed class to 'contact-form-section' in main.css to avoid generic '.contact' conflicts -->
<section class="contact-form-section" style="background-image: linear-gradient(to bottom, #f9f9f9, #fff);">
    <div class="container">
        <h1 style="color: #007bff;">Get in Touch</h1>
        <p style="color: #343a40; text-align: center;">We'd love to hear from you! Please fill out the form below to send us a message.</p>
        <form action="/send-message" method="post">
            <div class="form-group">
                <label for="name" style="color: #007bff;">Your Name</label>
                <input type="text" id="name" name="name" required style="border: 1px solid #ccc; border-radius: 5px; padding: 10px;">
            </div>
            <div class="form-group">
                <label for="email" style="color: #007bff;">Your Email</label>
                <input type="email" id="email" name="email" required style="border: 1px solid #ccc; border-radius: 5px; padding: 10px;">
            </div>
            <div class="form-group">
                <label for="message" style="color: #007bff;">Your Message</label>
                <textarea id="message" name="message" required style="border: 1px solid #ccc; border-radius: 5px; padding: 10px;"></textarea>
            </div>
            <button type="submit" style="background-color: #007bff; color: #fff; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer;">Send Message</button>
        </form>
    </div>
</section>

     <!-- Testimonials Section -->
<section class="testimonials">
    <h1>What Our Clients Say</h1>
    <div class="testimonial-carousel">
        <div class="testimonial-item">
            <p>"Shuton Photography captured our wedding beautifully!"</p>
            <h5>- Ruach</h5>
        </div>
        <div class="testimonial-item">
            <p>"Absolutely stunning corporate event photography!"</p>
            <h5>- CEO, Stunz</h5>
        </div>
        <div class="testimonial-item">
            <p>"Shuton Photography exceeded our expectations!"</p>
            <h5>- Emily & Michael</h5>
        </div>
        <div class="testimonial-item">
            <p>"Their attention to detail is impressive!"</p>
            <h5>- Rachel & David</h5>
        </div>
    </div>
</section>

    <!-- Footer Section -->
    <footer>
        <section class="section-five"> <!-- This class might be redundant if footer is styled directly -->
            <div class="container">
                <div class="contact-top">
                    <h3>CONTACT ME</h3>
                    <p>FOR ANY QUESTIONS OR SERVICES.</p>
                </div>
                <div class="contact-middle">
                    <div>
                        <span class="contact-icon">
                            <i class="fas fa-map-signs"></i>
                        </span>
                        <span>Address</span>
                        <p>Opposite - Distar Hotel, Voi</p>
                    </div>
                    <div>
                        <span class="contact-icon">
                            <i class="fas fa-phone"></i>
                        </span>
                        <span>Contact Number</span>
                        <p>0758926530 / 0722462645 / 0706872810</p>
                    </div>
                    <div>
                        <span class="contact-icon">
                            <i class="fas fa-paper-plane"></i>
                        </span>
                        <span>Email Address</span>
                        <p>shutonphotography@gmail.com</p>
                    </div>
                </div>
            </div>
        </section>
    </footer>
    <script src="script.js"></script>
</body>
</html>
