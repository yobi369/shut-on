<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#171714">
  <meta name="description" content="Contact Shuton Photography in Voi, Kenya to discuss wedding, event, portrait and commercial photography.">
  <title>Contact Shuton Photography | Voi, Kenya</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--ink:#171714;--paper:#f7f5f0;--muted:#6e6a62;--accent:#c7a46a;--line:#e5e0d6;--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.6}a{color:inherit;text-decoration:none}img{max-width:100%;display:block}.nav{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px clamp(18px,5vw,72px);background:var(--ink);color:white}.brand{display:flex;align-items:center;gap:11px;font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase}.mark{display:grid;place-items:center;width:40px;height:40px;border:1px solid var(--accent);border-radius:50%;font:1.25rem var(--serif)}.links{display:flex;align-items:center;gap:clamp(12px,2.5vw,30px);font-size:.82rem}.links a:hover{color:#e4c28b}.links .book{border:1px solid #aaa;padding:8px 12px}.hero{background:var(--ink);color:white;padding:clamp(55px,9vw,115px) clamp(20px,7vw,100px) clamp(65px,9vw,115px)}.eyebrow{text-transform:uppercase;letter-spacing:.18em;font-size:.7rem;font-weight:700;color:var(--accent)}h1,h2{font-family:var(--serif);font-weight:500;line-height:1.12;letter-spacing:-.035em}h1{font-size:clamp(2.7rem,7vw,5.8rem);margin:18px 0;max-width:850px}h1 em{color:#e4c28b}.hero p{max-width:590px;color:#d2d0ca;font-size:1rem}.layout{max-width:1180px;margin:auto;padding:65px clamp(20px,6vw,76px) 85px;display:grid;grid-template-columns:1fr .85fr;gap:clamp(28px,6vw,80px)}h2{font-size:clamp(2rem,4vw,3rem);margin:10px 0 15px}.muted{color:var(--muted)}.form-card,.info-card{background:#fff;border:1px solid var(--line);padding:clamp(20px,3vw,34px);min-width:0}.field{display:grid;gap:7px;margin:15px 0}.field label{font-size:.82rem;font-weight:700}.field input,.field textarea,.field select{width:100%;min-width:0;border:1px solid #d6d1c7;background:#fff;padding:13px;font:inherit;border-radius:2px}.field input:focus,.field textarea:focus,.field select:focus{outline:2px solid var(--accent);outline-offset:1px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 18px;background:var(--accent);color:var(--ink);border:0;font:700 .84rem var(--sans);cursor:pointer}.button:hover{filter:brightness(.96)}.form-card .button{width:100%;margin-top:7px}.hint{font-size:.76rem;color:var(--muted);margin:12px 0 0}.contact-item{padding:18px 0;border-bottom:1px solid var(--line)}.contact-item:last-child{border-bottom:0}.contact-item strong{display:block;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:#94703d;margin-bottom:5px}.contact-item p{margin:0;color:var(--muted);overflow-wrap:anywhere}.contact-item a{font-weight:600;overflow-wrap:anywhere}.whatsapp{background:#eeece5;padding:25px;margin-top:20px}.whatsapp p{font-size:.88rem;color:var(--muted)}footer{background:var(--ink);color:white;padding:24px clamp(20px,6vw,76px);display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;font-size:.78rem}footer span{color:#aaa}@media(max-width:760px){.nav{align-items:flex-start;padding:15px 16px}.links{justify-content:flex-end;flex-wrap:wrap;font-size:.72rem;gap:9px}.links a:not(.book){display:none}.links .book{padding:7px 9px}.layout{grid-template-columns:1fr;padding-top:38px;padding-bottom:55px}.hero{padding-top:55px;padding-bottom:60px}}@media(max-width:380px){.brand{font-size:.65rem;letter-spacing:.06em}.mark{width:34px;height:34px}.links{font-size:.65rem}.hero h1{font-size:2.5rem}}
  </style>
</head>
<body>
  <nav class="nav" aria-label="Main navigation">
    <a class="brand" href="/" aria-label="Shuton Photography home"><span class="mark">S</span><span>Shuton<br>Photography</span></a>
    <div class="links"><a href="/">Home</a><a href="/gallery">Gallery</a><a href="/work">Our work</a><a href="/blog">Journal</a><a class="book" href="/contact">Book a session ↗</a></div>
  </nav>
  <header class="hero">
    <div class="eyebrow">Let's make something memorable</div>
    <h1>Tell us about <em>your moment.</em></h1>
    <p>Planning a wedding, celebration, portrait session or brand shoot? Share a few details and continue directly with our studio on WhatsApp.</p>
  </header>
  <main class="layout">
    <section class="form-card">
      <div class="eyebrow">Start a conversation</div><h2>What are you planning?</h2>
      <p class="muted">Complete this short form. It will open WhatsApp with your message ready to send to the studio.</p>
      <form id="enquiry-form">
        <div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" maxlength="100" required></div>
        <div class="field"><label for="reply">Your email or phone (optional)</label><input id="reply" name="reply" autocomplete="email" maxlength="150"></div>
        <div class="field"><label for="service">Photography service</label><select id="service" name="service"><option>Wedding or event</option><option>Portrait or graduation</option><option>Corporate or brand</option><option>Video coverage</option><option>Other enquiry</option></select></div>
        <div class="field"><label for="date">Event date (optional)</label><input id="date" name="date" type="date"></div>
        <div class="field"><label for="details">Tell us a little more</label><textarea id="details" name="details" rows="4" maxlength="1500" required placeholder="Location, date, what you need, or any questions…"></textarea></div>
        <button class="button" type="submit">Continue on WhatsApp ↗</button>
        <p class="hint">Your message is not submitted until you press Send in WhatsApp.</p>
      </form>
    </section>
    <aside>
      <section class="info-card">
        <div class="eyebrow">Studio details</div><h2>We'd love to hear from you.</h2>
        <div class="contact-item"><strong>Visit</strong><p>Opposite Distar Hotel, Voi, Taita Taveta, Kenya</p></div>
        <div class="contact-item"><strong>Call the studio</strong><a href="tel:+254758926530">+254 758 926 530</a></div>
        <div class="contact-item"><strong>Email</strong><a href="mailto:shutonphotography@gmail.com">shutonphotography@gmail.com</a></div>
        <div class="contact-item"><strong>Service area</strong><p>Voi and surrounding areas in Taita Taveta, Kenya</p></div>
      </section>
      <section class="whatsapp"><div class="eyebrow">Quick contact</div><h2>Prefer a quick chat?</h2><p>Contact the studio directly. We'll discuss your plans, availability and the right coverage for your event.</p><a class="button" href="https://wa.me/254758926530?text=Hello%20Shuton%20Photography%2C%20I%27d%20like%20to%20enquire%20about%20a%20shoot." target="_blank" rel="noopener noreferrer">Message on WhatsApp ↗</a></section>
    </aside>
  </main>
  <footer><div>© <span id="year"></span> Shuton Photography</div><span>Stories worth keeping, captured with care.</span><a href="/admin">Studio login ↗</a></footer>
  <script>
    document.getElementById('year').textContent = new Date().getFullYear();
    document.getElementById('enquiry-form').addEventListener('submit', function(event) {
      event.preventDefault();
      const value = (id) => document.getElementById(id).value.trim();
      const parts = [
        'Hello Shuton Photography, I would like to enquire about a shoot.',
        'Name: ' + value('name'),
        value('reply') ? 'Contact: ' + value('reply') : '',
        'Service: ' + value('service'),
        value('date') ? 'Event date: ' + value('date') : '',
        'Details: ' + value('details')
      ].filter(Boolean);
      window.open('https://wa.me/254758926530?text=' + encodeURIComponent(parts.join('\n')), '_blank', 'noopener,noreferrer');
    });
  </script>
</body>
</html>